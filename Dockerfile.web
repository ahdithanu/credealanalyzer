# The SPA, built and served as static files.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --silent || npm install --silent
COPY public ./public
COPY src ./src
ARG REACT_APP_API_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL
# INLINE_RUNTIME_CHUNK=false comes from the build script in package.json: the
# CloudFront CSP has no 'unsafe-inline' on script-src, so an inlined runtime
# chunk is a blank page with a console error.
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
# Client-side routing: a deep link to /pipeline is not a file on disk.
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  location / { try_files $uri $uri/ /index.html; }\n\
}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
